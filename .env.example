SARCADE_ENV=development
SARCADE_API_PORT=8000
POSTGRES_DB=sarcade
POSTGRES_USER=sarcade
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MQTT_HOST=mqtt
MQTT_PORT=1883
# Dossier du client Web SARCADE (build Flutter web). Vide : non servi.
SARCADE_WEB_ROOT=
# Jeton de l'outil d'administration (à générer et placer soi-même, jamais dans le dépôt).
SARCADE_ADMIN_TOKEN=
# Version de l'image du serveur, tenue par docker/updater.sh.
SARCADE_IMAGE_TAG=edge
# APRS (doc docs/aprs-v0.1.md)
# Réception par Internet (APRS-IS), en lecture seule : 1 pour l'activer.
SARCADE_APRS_IS=0
# Serveur APRS-IS : euro.aprs2.net (Europe) par défaut, rotate.aprs2.net (monde).
SARCADE_APRS_IS_HOST=euro.aprs2.net
SARCADE_APRS_IS_PORT=14580
# Indicatif de l'ADRASEC, seulement pour émettre en radio locale.
SARCADE_APRS_CALLSIGN=
# Indicatif de connexion à APRS-IS (lecture seule, sans code d'accès) ; obligatoire, N0CALL est refusé.
# Un SSID dédié évite le conflit avec vos propres stations, ex. F4JPO-SC.
SARCADE_APRS_IS_LOGIN=
# Réveil des appareils SARCADE fermé (docs/wakeup-v0.1.md).
# Android : contenu JSON du compte de service Firebase (ou chemin du fichier
# monté dans le conteneur) ; vide = Android non réveillé. Jamais dans le dépôt.
SARCADE_FCM_SERVICE_ACCOUNT=
# Contact déclaré aux services Web Push (défaut mailto:github@sdubos.com).
SARCADE_VAPID_SUBJECT=

# ADS-B (module ADRASEC, étape 1) : aéronefs autour de l'événement par OpenSky
# Network. Client API OpenSky (OAuth2) ; le secret ne se met qu'ici, jamais
# ailleurs. Sans identifiants, la couche « Aéronefs » reste vide.
# Intervalle : 30 s au moins (quota de 4 000 crédits par jour).
SARCADE_OPENSKY_CLIENT_ID=
SARCADE_OPENSKY_CLIENT_SECRET=
SARCADE_ADSB_INTERVAL_S=30
